{
  "name": "via",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "web:preview": "vite preview",
    "lint": "eslint .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron ./electron/main.mjs\"",
    "electron:build": "npm run web:build && electron-builder",
    "electron:build:zip": "npm run web:build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.example.via",
    "productName": "Via Audio Capture",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/preload.mjs"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "extraMetadata": {
      "main": "electron/main.mjs"
    }
  }
}
